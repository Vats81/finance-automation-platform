# --- App ---
APP_ENV=local
APP_NAME=finance-automation-platform
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=fap_user
POSTGRES_PASSWORD=fap_dev_password
POSTGRES_DB=fap_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fap_user:fap_dev_password@postgres:5432/fap_db
DATABASE_URL_SYNC=postgresql+psycopg2://fap_user:fap_dev_password@postgres:5432/fap_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=fap_user
RABBITMQ_DEFAULT_PASS=fap_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://fap_user:fap_dev_password@rabbitmq:5672//

# --- Azure Blob Storage (Azurite emulator for local dev) ---
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=documents

# --- Microsoft Entra ID (OIDC) ---
# Register two App Registrations in Entra ID: one for the SPA (frontend), one for the API (backend).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_APPLICATION_ID_URI=api://finance-automation-platform
ENTRA_JWKS_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
# When true, backend accepts a static dev bearer token instead of validating real Entra JWTs (local dev only).
AUTH_DEV_MODE=true
AUTH_DEV_MODE_SHARED_SECRET=dev-only-insecure-secret

# --- Approval thresholds (cents, USD) ---
APPROVAL_THRESHOLD_L1_MAX=100000
APPROVAL_THRESHOLD_L2_MAX=1000000

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_WRITE=30/minute

# --- Self-serve (local) auth: SMB Finance Manager product ---
# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-jwt-secret
JWT_ACCESS_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2
FRONTEND_BASE_URL=http://localhost:3000

# --- Outbound email (verification / password reset links) ---
# Leave both blank in local dev: emails are logged to the backend/worker
# console instead of sent (see shared/infrastructure/email_sender.py).
# RESEND_API_KEY (HTTPS-based) is checked first and, if set, used instead of
# SMTP — several hosts (this app's own Render deployment included) silently
# block outbound SMTP ports, so the HTTPS-based option is the reliable
# default recommendation; SMTP still works fine wherever those ports aren't
# blocked.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com

# --- Outbound WhatsApp (report delivery) ---
# Leave WHATSAPP_PROVIDER=console for local dev: messages are logged instead
# of sent (see shared/infrastructure/whatsapp_sender.py). Set to "twilio"
# plus the three fields below to send real WhatsApp messages.
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- AI Business Assistant / Insights / Forecasting / Receipt Scanner ---
# Leave AI_PROVIDER=console for local dev: a fixed "not configured" message
# is returned instead of a real answer (see shared/infrastructure/ai_client.py).
# Set to "anthropic" plus a real key to enable real AI answers.
AI_PROVIDER=console
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe billing (subscription checkout + Customer Portal) ---
# Leave STRIPE_SECRET_KEY blank to keep plan changes as a free, direct field
# flip (no real billing) — see business/application/commands/change_business_plan.py.
# Set all four to enable real (or Stripe test-mode) billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# --- One-time demo-account seeding (see backend/scripts/seed_demo_users.py
# and the GET /internal/seed-demo-users route) ---
# Leave blank to disable the route entirely. Only needed on hosts with no
# shell access (e.g. Render's free tier) — set it, hit the route once, then
# blank it again to lock the route back down.
SEED_SECRET=

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=fap-backend
OTEL_EXPORTER=console

# --- Frontend (Next.js public env, mirrored in frontend/.env.local.example) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_API_SCOPE=api://finance-automation-platform/access_as_user
NEXT_PUBLIC_AUTH_DEV_MODE=true
